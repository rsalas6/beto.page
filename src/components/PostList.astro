---
import { hasPage, shortDate, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="max-w-xl space-y-5">
  {
    posts.map((post) => (
      <li class="flex items-baseline justify-between gap-8">
        {hasPage(post) ? (
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        ) : (
          <span>{post.data.title}</span>
        )}
        <time
          datetime={post.data.date.toISOString()}
          class="shrink-0 text-muted tabular-nums"
        >
          {shortDate(post.data.date)}
        </time>
      </li>
    ))
  }
</ul>
