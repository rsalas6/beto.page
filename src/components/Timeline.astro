---
interface Item {
  name: string;
  detail: string;
  period: string;
  note?: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<section class="mt-20" aria-label={title}>
  <h2 class="text-center font-serif text-[24px] italic">{title}</h2>
  <ul class="mx-auto mt-8 max-w-[34rem] space-y-6">
    {
      items.map((item) => (
        <li>
          <div class="flex items-baseline justify-between gap-8">
            <span>{item.name}</span>
            <span class="detail shrink-0 tabular-nums">{item.period}</span>
          </div>
          <p class="text-[18px] text-muted">{item.detail}</p>
          {item.note && <p class="detail">{item.note}</p>}
        </li>
      ))
    }
  </ul>
</section>
