---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/400-italic.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@/styles/global.css";
import { SITE } from "@/site";

interface Props {
  title?: string;
  description?: string;
  /** Slug of the post, so the share card matches the page. */
  ogId?: string;
}

const { title, description = SITE.description, ogId } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
const ogImage = new URL(`/og/${ogId ?? "default"}.png`, Astro.site);
// Reversed + base64 so no "user@domain" or "mailto:" appears in the page source.
const encodedEmail = btoa(SITE.email.split("").reverse().join(""));
const nav = [
  { href: "/", label: "home" },
  { href: "/tools/", label: "tools" },
  { href: "/rss.xml", label: "rss" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#111111" />
  </head>
  <body>
    <div class="px-6 py-10 sm:px-18 sm:py-12">
      <header>
        <a
          href="/"
          class="font-serif text-[20px] no-underline hover:underline"
          >roberto salas</a
        >
      </header>

      <main class="mt-20 sm:mt-24">
        <slot />
      </main>

      <footer class="mt-16 max-w-xl">
        <p class="text-rule" aria-hidden="true">— — —</p>
        <p class="mt-10">
          Say hi.<br />
          <a id="email" data-e={encodedEmail} class="no-underline"
            >{SITE.email.replace("@", " [at] ")}</a
          ><span class="cursor-block" aria-hidden="true"></span>
        </p>
        <nav class="mt-16 flex items-baseline justify-between gap-8 text-muted">
          <span>beto.page · {year}</span>
          <span class="flex gap-6">
            {
              nav.map((item) => (
                <a href={item.href} class="no-underline hover:text-paper">
                  {item.label}
                </a>
              ))
            }
          </span>
        </nav>
      </footer>
      <script is:inline>
        // The address is never in the HTML; it's rebuilt here to keep scrapers away.
        const el = document.getElementById("email");
        const email = atob(el.dataset.e).split("").reverse().join("");
        el.href = "mailto:" + email;
        el.textContent = email;
      </script>
    </div>
  </body>
</html>
