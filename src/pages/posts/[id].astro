---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPosts, hasPage, longDate, type Post } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts
    .filter(hasPage)
    .map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} ogId={post.id}>
  <article>
    <h1
      class="text-center font-serif text-[38px] leading-[1.15] font-light tracking-[-0.01em] sm:text-[46px]"
    >
      {post.data.title}
    </h1>
    <p class="detail mt-6 flex flex-wrap items-baseline justify-center gap-x-4">
      <time datetime={post.data.date.toISOString()}>{longDate(post.data.date)}</time>
      {
        post.data.tags.map((tag) => (
          <a href={`/tags/${tag}/`} class="no-underline hover:text-fg">
            #{tag}
          </a>
        ))
      }
    </p>

    {
      post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? ""}
          class="mt-14 w-full border border-rule"
          width="1200"
          height="630"
          loading="eager"
        />
      )
    }

    <div
      class="prose mt-14 max-w-none font-sans text-[19px] leading-[1.8] font-light prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight prose-h2:mt-14 prose-h2:text-[28px] prose-h3:text-[24px] prose-p:font-light prose-a:font-normal prose-a:decoration-rule prose-a:underline-offset-4 hover:prose-a:decoration-fg prose-code:font-mono prose-code:text-[0.8em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-none prose-pre:border prose-pre:border-rule prose-pre:bg-shade prose-pre:font-mono prose-pre:text-[13px] prose-th:font-normal prose-table:text-[16px] prose-table:font-mono"
    >
      <Content />
    </div>
  </article>
</Layout>
