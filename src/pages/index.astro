---
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/PostList.astro";
import { getPosts } from "@/lib/posts";
import { SITE } from "@/site";

const posts = await getPosts();
---

<Layout>
  <h1
    class="font-serif text-[40px] leading-[1.08] tracking-[-0.02em] sm:text-[64px]"
  >
    Hi, I'm Beto.<br /><span id="tagline">{SITE.taglines[0]}</span>
  </h1>
  <script is:inline define:vars={{ taglines: SITE.taglines }}>
    // Pick a different tagline than the last one this tab saw.
    let last = -1;
    try {
      last = Number(sessionStorage.getItem("tagline") ?? -1);
    } catch {}
    let i = Math.floor(Math.random() * taglines.length);
    if (i === last) i = (i + 1) % taglines.length;
    document.getElementById("tagline").textContent = taglines[i];
    try {
      sessionStorage.setItem("tagline", String(i));
    } catch {}
  </script>

  <p class="mt-12 max-w-xl">
    Currently at <a href="https://www.micro1.ai/" target="_blank" rel="noopener"
      >micro1</a
    >, teaching AI to be a little less wrong. Here you'll find
    my thoughts, experiments, and the occasional glorious failure.
  </p>

  <ul class="mt-12 flex gap-6">
    {
      SITE.links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            class="block text-muted no-underline transition-colors hover:text-paper"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {link.icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  {
    posts.length > 0 && (
      <>
        <p class="mt-16 text-rule" aria-hidden="true">
          — — —
        </p>
        <section class="mt-16" aria-label="Writing">
          <PostList posts={posts} />
        </section>
      </>
    )
  }
</Layout>
