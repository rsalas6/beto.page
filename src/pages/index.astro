---
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/PostList.astro";
import { getPosts } from "@/lib/posts";
import { SITE } from "@/site";

const posts = await getPosts();
---

<Layout>
  <h1
    class="font-serif text-[40px] leading-[1.08] tracking-[-0.02em] sm:text-[64px]"
  >
    Building things,<br />writing them down.
  </h1>

  <p class="mt-12 max-w-xl">
    I love building things. I've spent years creating systems, and these days
    I'm building them with AI at the core.
  </p>

  <ul class="mt-12 flex gap-6">
    {
      SITE.links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            class="block text-muted no-underline transition-colors hover:text-paper"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {link.icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  {
    posts.length > 0 && (
      <>
        <p class="mt-16 text-rule" aria-hidden="true">
          — — —
        </p>
        <section class="mt-16" aria-label="Writing">
          <PostList posts={posts} />
        </section>
      </>
    )
  }
</Layout>
